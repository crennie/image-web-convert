{
    "name": "@image-web-convert/source",
    "version": "0.0.0",
    "license": "MIT",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "node tools/nx.mjs run-many --targets=dev,serve -p web api",
        "build": "node tools/nx.mjs run-many -t build",
        "test": "node tools/nx.mjs run-many -t test",
        "coverage:api": "cd apps/api && ../../node_modules/.bin/vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
        "typecheck": "node tools/nx.mjs run-many -t typecheck",
        "lint": "node tools/nx.mjs run-many -t lint",
        "lint:fix": "node tools/nx.mjs run-many -t lint -- --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:use-cases": "node tools/check-use-case-inventory.mjs",
        "soak:api": "node tools/soak-api.mjs",
        "ci:hook": "node tools/nx.mjs run-many -t lint test build typecheck e2e browser-integration --parallel=1"
    },
    "private": true,
    "dependencies": {
        "@react-router/node": "8.4.0",
        "@react-router/serve": "8.4.0",
