{
    "name": "@image-web-convert/api-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "implicitDependencies": [
            "@image-web-convert/api"
        ],
        "targets": {
            "e2e": {
                "executor": "nx:noop",
                "dependsOn": [
                    "test"
                ]
            },
            "build-fixture": {
                "executor": "nx:run-commands",
                "dependsOn": [
                    "@image-web-convert/api:build"
                ],
                "options": {
                    "cwd": "apps/api-e2e",
                    "command": "vite build --config fixture.config.ts"
                }
            },
            "test": {
                "cache": false,
                "dependsOn": [
                    "build-fixture"
                ]
            }
        }
    }
}
