{
    "name": "@image-web-convert/api-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "implicitDependencies": [
            "@image-web-convert/api"
        ],
        "targets": {
            "e2e": {
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "apps/api-e2e",
                    "command": "vitest run"
                },
                "dependsOn": [
                    "@image-web-convert/api:build"
                ]
            }
        }
    }
}
